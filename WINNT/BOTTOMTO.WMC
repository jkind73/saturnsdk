//  Startup procedure for Toolbar 
HWND BLD_BottomtoolbarTbFuncDef(HWND hWnd,char *szDlgName,UINT message)
    {
    DLGPROC     lpProc;
    HWND        hDlg;
 
    lpProc   = (DLGPROC)MakeProcInstance((FARPROC)BLD_BottomtoolbarTbProc,hInst);
    hDlg     = BLDCreateClientDlg((szDlgName?szDlgName:"BOTTOMTOOLBAR"),
                                  hWnd,message,lpProc,BLDTOOLBARBOTTOM,FALSE);
    if (hDlg==0)
        BLDDisplayMessage(hWnd,BLD_CannotCreate,(szDlgName?szDlgName:"BOTTOMTOOLBAR"),
                          MB_OK | MB_ICONHAND);
    else
        {
        if(!BLDAddClientDlg(hDlg,lpProc))
            {
            BLDDisplayMessage(hWnd,BLD_CannotCreate,(szDlgName?szDlgName:"BOTTOMTOOLBAR"),
                          MB_OK | MB_ICONHAND);
            DestroyWindow(hDlg);
            FreeProcInstance((FARPROC)lpProc);
            return FALSE;
            }
        else
            ShowWindow(hDlg,SW_SHOW);
        }
    return hDlg;
    }
 
 
//  Default dialog box procedure 
BOOL BLD_BottomtoolbarDlgDefault(HWND hDlg,UINT message,WPARAM wParam,LPARAM lParam)
    {
    BOOL        bRet;
    HWND        hWnd;
 
    hWnd        = hDlg;
    bRet        = FALSE;    // Default return value if not processed
 
    if(BLDDlgMsgFilter(hDlg,message,wParam,lParam,BLDTOOLBARBOTTOM,IDH_DLG_BOTTOMTOOLBAR,&bRet))
        return bRet;
    
    switch(message)
        {
 
    case WM_INITDIALOG:
        bRet     = TRUE;     // Default return for WM_INITDIALOG is TRUE
        mhAddWindow(GetDlgItem(hDlg,108));
        break;
 
    case WM_COMMAND:
        break;
 
    case WM_DRAWITEM:
            {
            LPDRAWITEMSTRUCT lpDrawItem;
 
            lpDrawItem = (LPDRAWITEMSTRUCT)lParam;
            if(BLDDrawItem(hDlg,lpDrawItem))
                 return TRUE;
            }
            break;
        break;
 
    case WM_DESTROY:
        BLDExitBrush(GetDlgItem(hDlg,108));
        mhRemoveWindow(GetDlgItem(hDlg,108));
        BLDExitBrush(GetDlgItem(hDlg,110));
        break;
 
#ifdef WIN32
    case WM_CTLCOLORMSGBOX:
    case WM_CTLCOLOREDIT:
    case WM_CTLCOLORLISTBOX:
    case WM_CTLCOLORBTN:
    case WM_CTLCOLORDLG:
    case WM_CTLCOLORSCROLLBAR:
    case WM_CTLCOLORSTATIC:
#else
    case WM_CTLCOLOR:
#endif
        // Extracting data from message
        {
        HWND         hCtrl;
 
#ifdef WIN32
        hCtrl        = (HWND)lParam;
#else
        hCtrl        = (HWND)LOWORD(lParam);
#endif
#ifdef WIN32
        if(message == WM_CTLCOLORDLG)
            return (BOOL)BLDCtlColorStockBrush(hDlg,LTGRAY_BRUSH);
#else
        if(HIWORD(lParam) == CTLCOLOR_DLG)
            return (BOOL)BLDCtlColorStockBrush(hDlg,LTGRAY_BRUSH);
#endif
        switch(GetDlgCtrlID(hCtrl))
            {
        case 108:
            SetBkColor((HDC)wParam,RGB(255,255,255));
            SetBkMode((HDC)wParam,TRANSPARENT);
            return (BOOL)BLDCtlColorStockBrush(hCtrl,LTGRAY_BRUSH);
            break;
        case 110:
            SetTextColor((HDC)wParam,RGB(0,0,0));
            SetBkColor((HDC)wParam,RGB(255,255,255));
            SetBkMode((HDC)wParam,TRANSPARENT);
            return (BOOL)BLDCtlColorStockBrush(hCtrl,LTGRAY_BRUSH);
            break;
            }
        }
        break;
 
    case WM_NCDESTROY:
        BLDRemoveClientDlg(hDlg);
        break;
 
    default:
        break;
        }
    return bRet;             //  No explicit return - return default
    }
